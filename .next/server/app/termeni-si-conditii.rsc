9:["$","h1",null,{"children":"Termeni și Condiții"}]
a:["$","p",null,{"style":{"color":"var(--muted)","marginBottom":"32px"},"children":"Ultima actualizare: 6 august 2026"}]
b:["$","div",null,{"style":{"background":"var(--card-bg)","border":"1px solid var(--neon-green)","borderRadius":"16px","padding":"24px","marginBottom":"40px"},"children":["$","p",null,{"style":{"color":"var(--ink)","fontWeight":600,"margin":0,"fontSize":"0.95rem"},"children":"“CV Finance oferă servicii de analiză și consultanță financiară. Rezultatele analizelor sunt orientative și nu reprezintă o garanție de aprobare a unui credit. Decizia finală aparține exclusiv instituției financiare partenere, conform propriilor criterii de eligibilitate.”"}]}]
c:["$","h2",null,{"children":"1. Termeni generali de utilizare"}]
d:["$","p",null,{"children":"Accesarea și utilizarea site-ului credite.cristianvaduva.com implică acceptarea deplină a prezentelor Termeni și Condiții. Dacă nu sunteți de acord cu termenii stabiliți, vă rugăm să întrerupeți utilizarea platformei."}]
e:["$","h2",null,{"children":"2. Rolul CV Finance"}]
f:["$","p",null,{"children":"CV Finance funcționează ca un birou de consultanță și intermediere financiară independentă. CV Finance NU este o bancă, o instituție financiară nebancară (IFN) și nu acordă împrumuturi direct."}]
10:["$","h2",null,{"children":"3. Responsabilitățile utilizatorului"}]
11:["$","p",null,{"children":"Utilizatorul este responsabil pentru furnizarea unor informații reale, corecte și complete în formularele de analiză. Furnizarea de date false sau eronate poate conduce la imposibilitatea analizării cererii."}]
12:["$","h2",null,{"children":"4. Scopul informațiilor de pe site"}]
13:["$","p",null,{"children":"Toate calculele, estimările și exemplele afișate pe site au rol exclusiv demonstrativ și orientativ. Condițiile finale de creditare sunt stabilite exclusiv în urma analizei dosarului de către partenerii bancari."}]
14:["$","h2",null,{"children":"5. Procesul de solicitare a analizei"}]
15:["$","p",null,{"children":"Trimiterea formularului constituie o solicitare gratuită de analiză financiară. Un consultant CV Finance vă va contacta telefonic sau prin email pentru a discuta opțiunile eligibile."}]
16:["$","h2",null,{"children":"6. Lipsa garanției de aprobare"}]
17:["$","p",null,{"children":"CV Finance nu garantează aprobarea niciunui credit. Aprobarea depinde 100% de profilul financiar al solicitantului și de politica internă de risc a instituțiilor partenere."}]
18:["$","h2",null,{"children":"7. Proprietate intelectuală"}]
19:["$","p",null,{"children":"Întreg conținutul text, elemente grafice, logo-uri și design ale platformei CV Finance sunt protejate de legislația privind drepturile de autor."}]
1a:["$","h2",null,{"children":"8. Limitarea răspunderii"}]
1b:["$","p",null,{"children":"CV Finance nu poate fi trasă la răspundere pentru eventualele decizii de respingere emise de instituțiile financiare sau pentru modificările de dobândă efectuate de bănci."}]
1c:["$","h2",null,{"children":"9. Modificarea termenilor"}]
1d:["$","p",null,{"children":"CV Finance își rezervă dreptul de a actualiza prezenta pagină în orice moment. Versiunea actualizată devine aplicabilă din momentul publicării pe site."}]
1e:["$","h2",null,{"children":"10. Contact legal"}]
1f:["$","p",null,{"children":"Pentru orice întrebare legală referitoare la termenii noștri, ne puteți contacta la adresa de email publicată pe site sau direct prin reprezentant legal Cristian Văduva."}]
